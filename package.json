{
  "name": "@megahertz/oxconfig",
  "version": "1.0.3",
  "description": "Shared configs for the Pulse monorepo",
  "type": "module",
  "exports": {
    "./*": "./*",
    "./tsconfig": "./tsconfig.base.json",
    "./oxlint": "./oxlint/index.js",
    "./oxfmt": "./oxfmt.js"
  },
  "scripts": {
    "check": "npm run lint",
    "format": "oxfmt && oxlint --fix",
    "lint": "oxfmt --check && oxlint",
    "postversion": "git push && git push --tags"
  },
  "dependencies": {
    "eslint-plugin-perfectionist": "^5.14.0",
    "globals": "^17.14.0"
  },
  "devDependencies": {
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0"
  },
  "optionalDependencies": {
    "oxfmt": "*",
    "oxlint": "*"
  }
}
